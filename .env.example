# ── Ethereum source chains ────────────────────────────────────────────────────
# Mainnet RPC (Alchemy-compatible URL). The Sepolia endpoint is derived from the
# same key automatically unless SEPOLIA_RPC_URL is set explicitly.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Default source chain used by CLIs when no chain argument is passed:
# ethereum-mainnet | ethereum-sepolia
DEFAULT_SOURCE_CHAIN=ethereum-sepolia

# ── Controlled-demo wallet (Sepolia) ─────────────────────────────────────────
# Funded master = ATTACKER wallet in the controlled sandwich.
# NEVER put a production key here. This account only ever interacts with the
# public Sepolia testnet and the MEVTEST demo environment.
PRIVATE_KEY=0x_your_test_only_sepolia_key

# ── Creditcoin CC3 testnet ────────────────────────────────────────────────────
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Optional explicit chain-key pinning (otherwise resolved from ChainInfo precompile):
# CC_CHAIN_KEY_ETHEREUM_MAINNET=1
# CC_CHAIN_KEY_ETHEREUM_SEPOLIA=11155111

# Creditcoin signer for verifyAndEmit* on-chain proof persistence (optional;
# static verification needs no key). Testnet funds only!
CREDITCOIN_PRIVATE_KEY=

# ── API server ────────────────────────────────────────────────────────────────
PORT=3000
# EOA allowed to submit verified losses to the AncaSureClaims contract on-chain.
AUTHORIZER_PRIVATE_KEY=
# Deployed claims contract address (contracts/claims deploy step writes this).
CLAIMS_CONTRACT_ADDRESS=
