# AncaSure — environment configuration
# Copy this file to .env and fill in the values marked with YOUR_*

# ── Ethereum (Alchemy) ───────────────────────────────────────────────────────
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
DEFAULT_SOURCE_CHAIN=ethereum-sepolia

# ── Wallet ────────────────────────────────────────────────────────────────────
# Sepolia test key — funds the demo sandwich and claim payouts.
# Defaults to the master key; set AUTHORIZER_PRIVATE_KEY below to use a separate claim signer.
PRIVATE_KEY=0x_your_sepolia_private_key

# ── Creditcoin (optional) ─────────────────────────────────────────────────────
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# ── API server ────────────────────────────────────────────────────────────────
PORT=3000

# Wallet-book database. Set TURSO_* below to use managed SQLite instead of a local file.
DATABASE_PATH=data/ancasure.db
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional overrides (all have safe defaults — leave blank unless you need them)
# AUTHORIZER_PRIVATE_KEY=0x_separate_claim_signer_key
# CLAIMS_CONTRACT_ADDRESS=0x_deployed_claims_contract
# CREDITCOIN_PRIVATE_KEY=
# WALLETCONNECT_PROJECT_ID=
