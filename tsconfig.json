{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ancsure/shared": ["packages/shared/src/index.ts"],
      "@ancsure/ethereum": ["packages/ethereum/src/index.ts"],
      "@ancsure/detector": ["packages/detector/src/index.ts"],
      "@ancsure/simulator": ["packages/simulator/src/index.ts"],
      "@ancsure/creditcoin": ["packages/creditcoin/src/index.ts"],
      "@ancsure/demo/*": ["demo/*"]
    }
  },
  "include": ["packages/**/src/**/*.ts", "apps/**/src/**/*.ts", "demo/**/*.ts"]
}
